format_version = 1
root = "root"

[[node]]
id = "root"
type = "Node2D"
name = "Main"

[[node]]
id = "player"
type = "Sprite2D"
name = "Player"
parent = "root"

[node.props]
atlas = "res://assets/sheet.atlas.json"
frame = "player"

[node.script]
path = "res://scripts/player.py"
class = "Player"

[[node]]
id = "cam"
type = "Camera2D"
name = "Camera"
parent = "root"

[node.props]
position = [160.0, 240.0]

[[node]]
id = "hplabel"
type = "Label"
name = "HpLabel"
parent = "root"

[node.props]
color = "#4ADE80"
font_size = 28.0
position = [160.0, 100.0]
text = "HP: 3"

[[node]]
id = "hitbtn"
type = "Button"
name = "HitBtn"
parent = "root"

[node.props]
color = "#4ADE80"
font_size = 28.0
position = [160.0, 540.0]
size = [224.0, 53.0]
text = "HIT"

[node.script]
path = "res://scripts/hitbutton.py"
class = "HitButton"

[[instance]]
scene = "res://scenes/enemy.pitescene"
parent = "root"
prefix = "e1_"

[instance.overrides]
"sprite.position" = [480.0, 144.0]
