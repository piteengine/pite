format_version = 1
root = "root"

[[node]]
id = "root"
type = "Node2D"
name = "Main"

[[node]]
id = "player"
type = "Sprite2D"
name = "Player"
parent = "root"

[node.props]
texture = "res://assets/player.png"

[node.script]
path = "res://scripts/player.py"
class = "Player"

[[node]]
id = "cam"
type = "Camera2D"
name = "Camera"
parent = "root"

[node.props]
position = [100.0, 200.0]

[[node]]
id = "hplabel"
type = "Label"
name = "HpLabel"
parent = "root"

[node.props]
text = "HP: 3"
font_size = 20.0
position = [100.0, 80.0]
color = "#4ADE80"

[[node]]
id = "hitbtn"
type = "Button"
name = "HitBtn"
parent = "root"

[node.props]
text = "HIT"
font_size = 20.0
position = [500.0, 200.0]
size = [140.0, 44.0]
color = "#4ADE80"

[node.script]
path = "res://scripts/hitbutton.py"
class = "HitButton"

[[instance]]
scene = "res://scenes/enemy.pitescene"
parent = "root"
prefix = "e1_"

[instance.overrides]
"sprite.position" = [300.0, 120.0]
