format_version = 1
root = "enemy"

[[node]]
id = "enemy"
type = "Node2D"
name = "Enemy"

[node.script]
path = "res://scripts/enemy.py"
class = "Enemy"

[[node]]
id = "sprite"
type = "Sprite2D"
name = "Sprite"
parent = "enemy"

[node.props]
atlas = "res://assets/sheet.atlas.json"
frame = "enemy"
position = [0.0, 0.0]
