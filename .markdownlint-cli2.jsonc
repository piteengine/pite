{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "globs": ["**/*.md"],
  "ignores": [
    // Build output.
    "site/**",
    "target/**",
    // Generated from the node schema by `crates/pite-editor/build.rs`.
    "docs/reference/nodes/**",
    // Symlinks into `docs/`; linting them duplicates findings.
    "ACCESSIBILITY.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "SECURITY.md"
  ]
}
