from __future__ import annotations

from typing import Any

class Signal:
    def emit(self, *values: object) -> None: ...
    def connect(self, handler: object) -> None: ...

def signal(*types: object) -> Signal: ...

class Node:
    node_path: str
    def get_node(self, path: str) -> Node: ...
    def _ready(self) -> None: ...
    def _process(self, delta: float) -> None: ...
    # Anything undeclared here is dynamically typed instead of a checker
    # error: cross-node members, custom signals, script methods. A miss
    # still raises at runtime; declared members keep completing and checking.
    # Both directions: reads go through `__getattr__`, writes (like driving
    # a label's `text`) through `__setattr__`.
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...

def held(key: str) -> bool: ...
def pressed(key: str) -> bool: ...
def released(key: str) -> bool: ...
def mouse() -> tuple[float, float]: ...
def frames(atlas: str) -> list[str]: ...
def play(path: str, volume: float = ...) -> int: ...
def stop(id: int) -> None: ...
def set_volume(id: int, volume: float) -> None: ...
def is_playing(id: int) -> bool: ...

class Node2D(Node):
    position: tuple[float, float]

class Sprite2D(Node2D):
    texture: str
    atlas: str
    frame: str

class Camera2D(Node2D): ...

class Timer(Node):
    wait_time: float
    timeout: Signal

class Label(Node):
    text: str

class Button(Node2D):
    text: str
    size: tuple[float, float]
    pressed: Signal
