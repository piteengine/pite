// SPDX-License-Identifier: MIT OR Apache-2.0
use pite_physics::PhysicsWorld;
use std::sync::{Arc, Mutex, RwLock};

static CURRENT_PHYSICS: RwLock<Option<Arc<Mutex<PhysicsWorld>>>> = RwLock::new(None);

pub fn set_current_physics(physics: Option<Arc<Mutex<PhysicsWorld>>>) {
    *CURRENT_PHYSICS.write().unwrap() = physics;
}

pub fn current_physics() -> Option<Arc<Mutex<PhysicsWorld>>> {
    CURRENT_PHYSICS.read().unwrap().clone()
}

pub fn with_physics<R>(f: impl FnOnce(&mut PhysicsWorld) -> R) -> Option<R> {
    let arc = current_physics()?;
    let mut lock = arc.lock().ok()?;
    Some(f(&mut lock))
}
</file>

<file path="pite-script/src/vec2.rs">
// SPDX-License-Identifier: MIT OR Apache-2.0
use pyo3::prelude::*;
use std::sync::Arc;

#[pyclass(name = "Vec2", subclass)]
#[derive(Clone)]
pub struct Vec2 {
    pub(crate) x: f64,
    pub(crate) y: f64,
    pub(crate) target: Option<(Arc<crate::ScriptHost>, String)>,
}

impl std::fmt::Debug for Vec2 {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Vec2")
            .field("x", &self.x())
            .field("y", &self.y())
            .finish()
    }
}

impl Vec2 {
    pub fn x(&self) -> f64 {
        if let Some((host, node)) = &self.target {
            if let Some((x, _)) = host.get_node_position(node) {
                return x;
            }
        }
        self.x
    }

    pub fn y(&self) -> f64 {
        if let Some((host, node)) = &self.target {
            if let Some((_, y)) = host.get_node_position(node) {
                return y;
            }
        }
        self.y
    }

    pub fn set_target(&mut self, host: Arc<crate::ScriptHost>, node: String) {
        if let Some((x, y)) = host.get_node_position(&node) {
            self.x = x;
            self.y = y;
        }
        self.target = Some((host, node));
    }
}

impl<'py> pyo3::FromPyObject<'_, 'py> for Vec2 {
    type Error = PyErr;
    fn extract(ob: pyo3::Borrowed<'_, 'py, pyo3::PyAny>) -> Result<Self, Self::Error> {
        let b: pyo3::PyRef<'py, Vec2> = ob.extract()?;
        Ok(b.clone())
    }
}

#[pymethods]
impl Vec2 {
    #[new]
    #[pyo3(signature = (x = 0.0, y = 0.0))]
    pub fn new(x: f64, y: f64) -> Self {
        Self { x, y, target: None }
    }

    #[getter]
    pub fn get_x(&self) -> f64 {
        self.x()
    }

    #[setter]
    pub fn set_x(&mut self, val: f64) {
        self.x = val;
        if let Some((host, node)) = &self.target {
            let cur_y = self.y();
            self.y = cur_y;
            host.set_node_position(node, val, cur_y);
        }
    }

    #[getter]
    pub fn get_y(&self) -> f64 {
        self.y()
    }

    #[setter]
    pub fn set_y(&mut self, val: f64) {
        self.y = val;
        if let Some((host, node)) = &self.target {
            let cur_x = self.x();
            self.x = cur_x;
            host.set_node_position(node, cur_x, val);
        }
    }

    fn __repr__(&self) -> String {
        format!("Vec2({}, {})", self.x(), self.y())
    }

    fn __eq__(&self, other: &Bound<'_, PyAny>) -> bool {
        let (ox, oy) = if let Ok(other_vec) = other.extract::<Vec2>() {
            (other_vec.x(), other_vec.y())
        } else if let Ok((x, y)) = other.extract::<(f64, f64)>() {
            (x, y)
        } else {
            return false;
        };
        (self.x() - ox).abs() < 1e-6 && (self.y() - oy).abs() < 1e-6
    }

    fn __add__(&self, other: &Bound<'_, PyAny>) -> PyResult<Vec2> {
        let (ox, oy) = if let Ok(other_vec) = other.extract::<Vec2>() {
            (other_vec.x(), other_vec.y())
        } else if let Ok(t) = other.extract::<(f64, f64)>() {
            t
        } else {
            return Err(pyo3::exceptions::PyTypeError::new_err(
                "unsupported operand type for +: 'Vec2' and non-vector",
            ));
        };
        Ok(Vec2 {
            x: self.x() + ox,
            y: self.y() + oy,
            target: None,
        })
    }

    fn __sub__(&self, other: &Bound<'_, PyAny>) -> PyResult<Vec2> {
        let (ox, oy) = if let Ok(other_vec) = other.extract::<Vec2>() {
            (other_vec.x(), other_vec.y())
        } else if let Ok(t) = other.extract::<(f64, f64)>() {
            t
        } else {
            return Err(pyo3::exceptions::PyTypeError::new_err(
                "unsupported operand type for -: 'Vec2' and non-vector",
            ));
        };
        Ok(Vec2 {
            x: self.x() - ox,
            y: self.y() - oy,
            target: None,
        })
    }

    fn __mul__(&self, scalar: f64) -> Vec2 {
        Vec2 {
            x: self.x() * scalar,
            y: self.y() * scalar,
            target: None,
        }
    }

    fn __rmul__(&self, scalar: f64) -> Vec2 {
        Vec2 {
            x: self.x() * scalar,
            y: self.y() * scalar,
            target: None,
        }
    }

    fn __truediv__(&self, scalar: f64) -> PyResult<Vec2> {
        if scalar == 0.0 {
            return Err(pyo3::exceptions::PyZeroDivisionError::new_err(
                "division by zero",
            ));
        }
        Ok(Vec2 {
            x: self.x() / scalar,
            y: self.y() / scalar,
            target: None,
        })
    }

    fn __iadd__(&mut self, other: &Bound<'_, PyAny>) -> PyResult<()> {
        let (ox, oy) = if let Ok(other_vec) = other.extract::<Vec2>() {
            (other_vec.x(), other_vec.y())
        } else if let Ok(t) = other.extract::<(f64, f64)>() {
            t
        } else {
            return Err(pyo3::exceptions::PyTypeError::new_err(
                "unsupported operand type for +=: 'Vec2' and non-vector",
            ));
        };
        let cur_x = self.x();
        let cur_y = self.y();
        self.set_x(cur_x + ox);
        self.set_y(cur_y + oy);
        Ok(())
    }

    fn __isub__(&mut self, other: &Bound<'_, PyAny>) -> PyResult<()> {
        let (ox, oy) = if let Ok(other_vec) = other.extract::<Vec2>() {
            (other_vec.x(), other_vec.y())
        } else if let Ok(t) = other.extract::<(f64, f64)>() {
            t
        } else {
            return Err(pyo3::exceptions::PyTypeError::new_err(
                "unsupported operand type for -=: 'Vec2' and non-vector",
            ));
        };
        let cur_x = self.x();
        let cur_y = self.y();
        self.set_x(cur_x - ox);
        self.set_y(cur_y - oy);
        Ok(())
    }

    fn __imul__(&mut self, scalar: f64) {
        let cur_x = self.x();
        let cur_y = self.y();
        self.set_x(cur_x * scalar);
        self.set_y(cur_y * scalar);
    }

    fn __itruediv__(&mut self, scalar: f64) -> PyResult<()> {
        if scalar == 0.0 {
            return Err(pyo3::exceptions::PyZeroDivisionError::new_err(
                "division by zero",
            ));
        }
        let cur_x = self.x();
        let cur_y = self.y();
        self.set_x(cur_x / scalar);
        self.set_y(cur_y / scalar);
        Ok(())
    }

    fn __len__(&self) -> usize {
        2
    }

    fn __getitem__(&self, idx: isize) -> PyResult<f64> {
        match idx {
            0 | -2 => Ok(self.x()),
            1 | -1 => Ok(self.y()),
            _ => Err(pyo3::exceptions::PyIndexError::new_err(
                "Vec2 index out of range",
            )),
        }
    }

    fn __setitem__(&mut self, idx: isize, val: f64) -> PyResult<()> {
        match idx {
            0 | -2 => {
                self.set_x(val);
                Ok(())
            }
            1 | -1 => {
                self.set_y(val);
                Ok(())
            }
            _ => Err(pyo3::exceptions::PyIndexError::new_err(
                "Vec2 index out of range",
            )),
        }
    }

    fn __iter__(slf: Bound<'_, Self>) -> PyResult<Bound<'_, pyo3::types::PyIterator>> {
        let x = slf.borrow().x();
        let y = slf.borrow().y();
        let tuple = pyo3::types::PyTuple::new(slf.py(), [x, y])?;
        tuple.try_iter()
    }

    fn length(&self) -> f64 {
        let x = self.x();
        let y = self.y();
        (x * x + y * y).sqrt()
    }

    fn normalized(&self) -> Vec2 {
        let len = self.length();
        if len > 1e-6 {
            let x = self.x();
            let y = self.y();
            Vec2 {
                x: x / len,
                y: y / len,
                target: None,
            }
        } else {
            Vec2 {
                x: 0.0,
                y: 0.0,
                target: None,
            }
        }
    }

    fn to_tuple(&self) -> (f64, f64) {
        (self.x(), self.y())
    }
}

impl From<(f64, f64)> for Vec2 {
    fn from(t: (f64, f64)) -> Self {
        Self {
            x: t.0,
            y: t.1,
            target: None,
        }
    }
}
</file>

<file path="pite-script/build.rs">
// SPDX-License-Identifier: MIT OR Apache-2.0

fn main() {
    println!("cargo:rerun-if-env-changed=PYO3_PYTHON");
    println!("cargo:rerun-if-env-changed=LD_LIBRARY_PATH");

    let py = std::env::var("PYO3_PYTHON").unwrap_or_else(|_| "python3.12".to_string());
    let status = std::process::Command::new(&py)
        .arg("-c")
        .arg("import sys; assert sys.version_info >= (3, 12)")
        .status();

    if status.is_err() || !status.as_ref().map(|s| s.success()).unwrap_or(false) {
        let has_py = ["python3", "python"].iter().any(|cmd| {
            std::process::Command::new(cmd)
                .arg("-c")
                .arg("import sys; assert sys.version_info >= (3, 12)")
                .status()
                .map(|s| s.success())
                .unwrap_or(false)
        });

        if !has_py {
            println!("cargo:warning=");
            println!("cargo:warning=Python 3.12 with development headers was not detected.");
            println!(
                "cargo:warning=Pite requires Python 3.12 to build its embedded scripting engine."
            );
            println!("cargo:warning=On Ubuntu/Debian: sudo apt-get install python3.12-dev");
            println!("cargo:warning=On macOS:         brew install python@3.12");
            println!("cargo:warning=On Windows:       install Python 3.12 with dev headers from python.org");
            println!("cargo:warning=");
        }
    }
}
</file>

<file path="pite-script/README.md">
# pite-script

Embedded Python 3.12 scripting bridge and game API for the [Pite](https://github.com/piteengine/pite) game engine.

Powered by PyO3: embeds CPython 3.12, drives `_ready`, `_process(delta)`, and `_physics_process(delta)`, provides the `pite.*` module with native `Vec2` math, direct property mutation handles, typed signals, attribute-based input (`pite.held`, `pite.pressed`), declarative descriptors (`child`, `node`), and proxy caching.

## Versioning

Lockstep with the engine: `pite-script 0.x.y` is engine `0.x.y`.

## Docs

- API docs: <https://docs.rs/pite-script>
- Engine repo: <https://github.com/piteengine/pite>

## License

Dual-licensed MIT + Apache-2.0 ([LICENSE-MIT](https://github.com/piteengine/pite/blob/main/LICENSE-MIT), [LICENSE-APACHE](https://github.com/piteengine/pite/blob/main/LICENSE-APACHE)).
</file>

