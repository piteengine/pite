        assert!((fit_scale((1280, 720), (1920, 1080)) - 1.5).abs() < 1e-9);
        assert!((fit_scale((1280, 720), (1920, 800)) - (800.0 / 720.0)).abs() < 1e-9);
        assert!((fit_scale((1280, 720), (640, 360)) - 0.5).abs() < 1e-9);
        assert_eq!(fit_scale((0, 720), (1920, 1080)), 1.0);
