<file path=".github/workflows/ci.yml">
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

# Jobs share one cargo cache key and run in parallel (no needs: gates):
# each job recompiles only what it needs from cache, so serializing them
# bought latency without saving work.
jobs:
  fmt:
    name: Format check
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check out the repo
        uses: actions/checkout@v7
      - name: Set up the Rust toolchain with rustfmt
        uses: ./.github/actions/rust-python-env
        with:
          components: rustfmt
          python: "false"
          alsa: "false"
      - name: Check formatting
        run: cargo fmt --all -- --check

  build:
    name: Build the workspace
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
