        crate::input_clear();
        crate::input_begin_frame();
        crate::input_set_key("Space", true);
        sensor.call_process(0.016).unwrap();
        assert_eq!(listener.position(), Some((7.0, 0.0)));
        std::fs::remove_dir_all(&dir).ok();
    }

