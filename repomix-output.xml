    #[test]
    fn mock_round_trip_open_change_completion_diagnostics() {
        let mut bridge = Bridge::new();
        let mut tx = MockTransport::new();
        let uri = "file:///proj/scripts/player.py";

        bridge
            .did_open(&mut tx, uri, "import pite\noops\n")
