<file path="examples/minimal-2d/scripts/enemy.py">
import pite


class Enemy(pite.Node2D):
    def _ready(self):
        self.hp = 3
        self.get_node("../Player").hit.connect(self.on_player_hit)

    def on_player_hit(self, damage):
        self.hp = self.hp - damage
        x, y = self.position
        self.position = (x - 5.0 * damage, y)
        self.get_node("../HpLabel").text = f"HP: {self.hp}"
        pite.play("res://sfx/hit.wav")
</file>

<file path="examples/minimal-2d/scripts/hitbutton.py">
import pite


class HitButton(pite.Button):
    # No `pressed = pite.signal()` needed: `pressed` belongs to the
    # Button type itself and is declared by the engine.
    def _ready(self):
        self.get_node(".").pressed.connect(self.on_pressed)

    def on_pressed(self):
        self.get_node("../Player").hit.emit(1)
</file>

