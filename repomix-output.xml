            view_formats: &[],
        });
        let target_view = target.create_view(&Default::default());
        let quad = [
            SpriteVertex {
                pos: [-1.0, 1.0],
                uv: [0.0, 0.0],
            },
            SpriteVertex {
                pos: [1.0, 1.0],
